{
  "name": "everypath",
  "version": "0.1.0",
  "description": "Agent-declared statecharts, model-checked with TLA+, drawn as a review map",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayaa-arch/everypath.git"
  },
  "homepage": "https://github.com/dayaa-arch/everypath#readme",
  "bugs": {
    "url": "https://github.com/dayaa-arch/everypath/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "everypath": "dist/cli.js"
  },
  "exports": {
    "./types": {
      "types": "./dist/core/types.d.ts",
      "default": "./dist/core/types.js"
    }
  },
  "files": [
    "dist/",
    "skill/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx scripts/build-ui.ts",
    "dev": "tsx watch src/cli.ts serve example",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p src/ui/tsconfig.json",
    "lint": "biome check .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && tsx scripts/verify-requirements.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@dagrejs/dagre": "^3.1.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
